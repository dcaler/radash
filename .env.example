# raDash — environment configuration
#
# raDash reads from trundlr, HAARPi project folders and Zotero, and writes to
# none of them. Every source path below is mounted READ-ONLY (:ro) in
# docker-compose.yml; the only writable location is the radash-data volume.
#
# Copy to .env and fill in. .env is gitignored; this file is the tracked template.

# Port to expose the FastAPI app (trundlr defaults to 8251; raDash to 8261)
PORT=8261

# Database URL for SQLAlchemy
DATABASE_URL=sqlite:////app/data/radash.db

# ---- host paths, mounted read-only ----------------------------------------
# HOST paths, and they differ per machine. Set them to the absolute paths as
# the *host running Docker* sees them, not as any other machine sees them.
#
# If your files live on a NAS that is also mounted over NFS elsewhere, the same
# directory has two names, and using the wrong one makes every source report
# `missing` at /api/mounts. Deploying on the NAS means the NAS-native path.
#
#   HOST_ZOTERO_SQLITE     the zotero.sqlite file itself, not its directory
#   HOST_PROJECTS_DIR      the folder holding project directories, each with a
#                          haarpi.yaml and optionally .haarpi/corpus_ledger.json
#   HOST_PROFESSIONAL_DIR  the folder holding publications and the CV
HOST_ZOTERO_SQLITE=/path/to/Zotero/zotero.sqlite
HOST_PROJECTS_DIR=/path/to/work_projects
HOST_PROFESSIONAL_DIR=/path/to/professional_record

# ---- external services -----------------------------------------------------
# trundlr's REST API. Routes answer on a trailing slash and 307 without one.
TRUNDLR_URL=http://localhost:8251


# ---- identity --------------------------------------------------------------
# OpenAlex author ids, comma-separated. More than one is supported for authors
# whose record is split across duplicate profiles; candidates from each are
# kept separate with their provenance and proposed for adoption, never
# auto-merged.
OPENALEX_AUTHOR_IDS=A0000000000

# Your public CV page, if you have one. raDash reads it as a source of
# *claims*, not of truth, and reports where it diverges from what the indexes
# hold -- work that came out and never reached the page, and work the page
# claims that no index carries. Optional; unset simply skips the comparison.
CV_URL=https://example.com/cv

# Used for the OpenAlex and Semantic Scholar polite pools, which give better
# service to identified callers. Optional; both work without it.
CONTACT_EMAIL=you@example.com

# Secrets never live in this file or in .env — they come from the environment.
#   S2_API_KEY   optional; raises the Semantic Scholar rate limit. It does not
#                exempt you from 429s, which the adapter retries with backoff.
